{
  "productName": "Beo",
  "version": "0.2.0",
  "identifier": "org.beo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beo",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Beo — a clean, lightweight Android emulator manager",
    "longDescription": "Beo installs and manages official Google Android SDK command-line tools, system images, and virtual devices — no bundled adware, source-available under PolyForm Shield 1.0.0."
  }
}
